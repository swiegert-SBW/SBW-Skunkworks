# The SEC requires every request to say who you are.
# Use your real name or company and a real email.
SEC_USER_AGENT="FinSight Your Name your.email@example.com"

# Benz Bot: set this only in server-side environment variables (e.g. Vercel).
# A ChatGPT subscription/login cannot authenticate the OpenAI API.
OPENAI_API_KEY=""
# Optional: model for short news summaries
OPENAI_NEWS_MODEL="gpt-4.1-mini"

# Optional: Massive (formerly Polygon) news API for Benz Bot; keep server-side only.
MASSIVE_API_KEY=""
