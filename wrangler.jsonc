{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sbw-skunkworks",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "previews": {},
  "preview_urls": true
}
